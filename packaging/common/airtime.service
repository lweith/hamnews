[Unit]
Description=airtime: channel use by callsign-SSID, from direwolf
Documentation=file:///usr/share/doc/airtime/README.md
After=network.target direwolf.service

[Service]
EnvironmentFile=/etc/airtime.conf
ExecStart=/usr/bin/airtime -agw ${AGW} -http ${HTTP} -bitrate ${BITRATE} -txdelay ${TXDELAY} $OPTS
Restart=on-failure
RestartSec=15
DynamicUser=yes
StateDirectory=airtime
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
