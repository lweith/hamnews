[Unit]
Description=hnlink: hamnews exchange on the local radio net
Documentation=file:///usr/share/doc/hnlink/README.md file:///usr/share/doc/hnlink/PROTOCOL.md
After=network.target hamnews.service direwolf.service

[Service]
EnvironmentFile=/etc/hnlink.conf
# Not configured yet: skip quietly instead of failing in a loop.
ExecCondition=/bin/sh -c 'test -n "$$CALL" || { echo "hnlink: set CALL in /etc/hnlink.conf" >&2; exit 1; }'
ExecStart=/usr/bin/hnlink run --call ${CALL} --kiss ${KISS} --nntp ${NNTP} --http ${HTTP} --from ${FROM} $OPTS
Restart=on-failure
RestartSec=15
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
