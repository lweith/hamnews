#!/bin/sh
set -e
. /usr/share/debconf/confmodule

CONF=/etc/hnlink.conf

# Values set in hnlink.conf (perhaps by hand) win over stored answers; empty ones
# don't, so a preseeded answer reaches a fresh install. (To stop hnlink, disable
# the service rather than clearing CALL.)
if [ -f "$CONF" ]; then
    v=$(sed -n 's/^CALL=//p' "$CONF" | tail -n1)
    [ -z "$v" ] || db_set hnlink/call "$v"
    v=$(sed -n 's/^FROM=//p' "$CONF" | tail -n1)
    [ -z "$v" ] || db_set hnlink/from "$v"
fi

valid() {
    c=$(printf '%s' "$1" | tr 'a-z' 'A-Z')
    printf '%s\n' "$c" | grep -Eq '^[A-Z0-9]{1,6}(-([0-9]|1[0-5]))?$'
}

while :; do
    db_input high hnlink/call || true
    db_go || true
    db_get hnlink/call
    if [ -z "$RET" ] || valid "$RET"; then break; fi
    db_subst hnlink/call-invalid call "$RET"
    db_input critical hnlink/call-invalid || true
    db_fset hnlink/call seen false
    db_set hnlink/call ""
    db_go || true
done

db_get hnlink/call
if [ -n "$RET" ]; then
    db_input medium hnlink/from || true
    db_go || true
fi
