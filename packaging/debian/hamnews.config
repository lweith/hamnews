#!/bin/sh
set -e
. /usr/share/debconf/confmodule

CONF=/etc/hamnews/inn.conf

# An existing inn.conf is the source of truth (it may have been edited by hand).
if [ -f "$CONF" ]; then
    cur=$(sed -n 's/^pathhost:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$CONF" | head -n1)
    if [ -n "$cur" ] && [ "$cur" != CHANGEME ]; then
        db_set hamnews/callsign "$cur"
    fi
fi

while :; do
    db_input high hamnews/callsign || true
    db_go || true
    db_get hamnews/callsign
    case "$RET" in
        "") break ;;
        *[!A-Za-z0-9-]*|-*|*-) ;;
        *) break ;;
    esac
    db_subst hamnews/callsign-invalid call "$RET"
    db_input critical hamnews/callsign-invalid || true
    db_fset hamnews/callsign seen false
    # Cleared, so a frontend that can't ask again ends the loop with CHANGEME.
    db_set hamnews/callsign ""
    db_go || true
done
