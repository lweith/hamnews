#!/usr/bin/make -f
# Build tree layout (assembled by packaging/build-deb.sh):
#   ./            INN source, patched
#   debian/common the shared hamnews/hnlink files (packaging/common)
#   debian/{hamnews,hnlink,airtime}.service  copies of the units, for dh_installsystemd
#   debian/prebuilt/hnlink  static Go binary for this architecture, plus docs

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -fcommon

H = debian/hamnews
L = debian/hnlink
C = debian/common

%:
	dh $@

override_dh_auto_configure:
	./configure --prefix=/usr/lib/hamnews \
	  --sysconfdir=/etc/hamnews \
	  --with-db-dir=/var/lib/hamnews \
	  --with-spool-dir=/var/spool/hamnews \
	  --with-log-dir=/var/log/hamnews \
	  --with-run-dir=/run/hamnews \
	  --with-tmp-dir=/var/spool/hamnews/tmp \
	  --without-perl --without-python --without-openssl --without-sasl \
	  --without-krb5 --without-bdb --without-zlib --without-sqlite3 \
	  --with-sendmail=/bin/true \
	  --with-news-user=news --with-news-group=news --with-news-master=news

override_dh_auto_test:

# INN ships a generated configure; regenerating it with bookworm's libtool breaks.
override_dh_autoreconf:

# INN's Makefile refuses every target before configure.
override_dh_auto_clean:
	[ ! -f Makefile.global ] || $(MAKE) distclean

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/$(H) install
	# Variable data is created at first start (hamnews-prestart) and by tmpfiles.d.
	install -d $(H)/usr/share/hamnews
	install -m644 $(H)/var/lib/hamnews/active $(H)/var/lib/hamnews/newsgroups $(H)/usr/share/hamnews/
	rm -rf $(H)/var $(H)/run $(H)/usr/lib/hamnews/include
	rm -f $(H)/usr/lib/hamnews/lib/*.a $(H)/usr/lib/hamnews/lib/*.la
	install -d $(H)/usr/share/doc
	mv $(H)/usr/lib/hamnews/doc $(H)/usr/share/doc/hamnews
	install -m644 $(C)/OPERATIONS.md $(H)/usr/share/doc/hamnews/
	find $(H)/usr/lib/hamnews/bin -type f -exec chmod 0755 {} +
	set -e; for f in storage.conf newsfeeds incoming.conf readers.conf expire.ctl groups; do \
	  install -m644 $(C)/$$f $(H)/etc/hamnews/$$f; done
	# inn.conf is generated by postinst (it carries the callsign), so not a conffile.
	rm -f $(H)/etc/hamnews/inn.conf
	install -m644 $(C)/inn.conf $(H)/usr/share/hamnews/inn.conf.dist
	install -m755 $(C)/hamnews-prestart $(C)/hamnews-sync-groups $(H)/usr/lib/hamnews/
	install -Dm644 $(C)/hamnews.tmpfiles $(H)/usr/lib/tmpfiles.d/hamnews.conf
	install -Dm644 $(C)/hamnews.sysusers $(H)/usr/lib/sysusers.d/hamnews.conf
	# hnlink
	install -Dm755 debian/prebuilt/hnlink $(L)/usr/bin/hnlink
	install -Dm644 $(C)/hnlink.conf $(L)/usr/share/hnlink/hnlink.conf.dist
	install -Dm644 -t $(L)/usr/share/doc/hnlink debian/prebuilt/README.md debian/prebuilt/PROTOCOL.md
	# itsjustnews
	install -Dm755 debian/prebuilt/itsjustnews debian/itsjustnews/usr/bin/itsjustnews
	# airtime
	install -Dm755 debian/prebuilt/airtime debian/airtime/usr/bin/airtime
	install -Dm644 $(C)/airtime.conf debian/airtime/etc/airtime.conf
	install -Dm644 debian/prebuilt/airtime-README.md debian/airtime/usr/share/doc/airtime/README.md

# hnlink, itsjustnews and airtime are static Go binaries: nothing to strip into a dbgsym, no shlibs.
override_dh_strip:
	dh_strip -Nhnlink -Nitsjustnews -Nairtime
override_dh_dwz:
	dh_dwz -Nhnlink -Nitsjustnews -Nairtime

# INN's private libraries live in /usr/lib/hamnews/lib (found via RUNPATH).
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/$(H)/usr/lib/hamnews/lib

override_dh_makeshlibs:
	dh_makeshlibs -n --no-scripts
